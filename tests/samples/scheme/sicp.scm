; Examples from SICP: Newton's square root, symbolic differentiation,
; rational numbers on pairs.
(define (sqrt-iter guess x)
  (if (good-enough? guess x) guess (sqrt-iter (improve guess x) x)))
(define (improve guess x) (average guess (/ x guess)))
(define (average x y) (/ (+ x y) 2))
(define (good-enough? guess x) (< (abs (- (square guess) x)) 0.001))
(define (my-sqrt x) (sqrt-iter 1.0 x))
(display (my-sqrt 9))
(newline)
(define (deriv expr var)
  (cond ((number? expr) 0)
        ((symbol? expr) (if (eq? expr var) 1 0))
        ((eq? (car expr) '+) (make-sum (deriv (cadr expr) var) (deriv (caddr expr) var)))
        ((eq? (car expr) '*)
         (make-sum (make-product (cadr expr) (deriv (caddr expr) var))
                   (make-product (deriv (cadr expr) var) (caddr expr))))
        (else (error "unknown expression" expr))))
(define (make-sum a b)
  (cond ((and (number? a) (number? b)) (+ a b))
        ((eqv? a 0) b)
        ((eqv? b 0) a)
        (else (list '+ a b))))
(define (make-product a b)
  (cond ((or (eqv? a 0) (eqv? b 0)) 0)
        ((eqv? a 1) b)
        ((eqv? b 1) a)
        ((and (number? a) (number? b)) (* a b))
        (else (list '* a b))))
(write (deriv '(+ x 3) 'x))
(newline)
(write (deriv '(* x y) 'x))
(newline)
(write (deriv '(* (* x y) (+ x 3)) 'x))
(newline)
(define (make-rat n d) (let ((g (gcd n d))) (cons (/ n g) (/ d g))))
(define (add-rat x y)
  (make-rat (+ (* (car x) (cdr y)) (* (car y) (cdr x))) (* (cdr x) (cdr y))))
(define (print-rat x) (display (car x)) (display "/") (display (cdr x)) (newline))
(print-rat (add-rat (make-rat 1 3) (make-rat 1 6)))
(define (accumulate op initial sequence)
  (if (null? sequence) initial (op (car sequence) (accumulate op initial (cdr sequence)))))
(display (accumulate + 0 (map square (filter odd? (iota 10 1)))))
(newline)
(define (count-change amount)
  (define (cc amount kinds)
    (cond ((= amount 0) 1)
          ((or (< amount 0) (= kinds 0)) 0)
          (else (+ (cc amount (- kinds 1)) (cc (- amount (first-denomination kinds)) kinds)))))
  (define (first-denomination kinds)
    (case kinds ((1) 1) ((2) 5) ((3) 10) ((4) 25) ((5) 50)))
  (cc amount 5))
(display (count-change 100))
(newline)

