; A small Scheme interpreter in Scheme (environments as association lists,
; closures, if, lambda, define).
(define (lookup var env)
  (cond ((null? env) (error "unbound variable" var))
        ((assq var (car env)) => cdr)
        (else (lookup var (cdr env)))))
(define (extend env vars vals) (cons (map cons vars vals) env))
(define (define! var val env) (set-car! env (cons (cons var val) (car env))))
(define (evaluate expr env)
  (cond ((or (number? expr) (string? expr) (boolean? expr)) expr)
        ((symbol? expr) (lookup expr env))
        (else
         (case (car expr)
           ((quote) (cadr expr))
           ((if) (if (evaluate (cadr expr) env) (evaluate (caddr expr) env) (evaluate (cadddr expr) env)))
           ((lambda) (list 'closure (cadr expr) (cddr expr) env))
           ((define) (define! (cadr expr) (evaluate (caddr expr) env) env) (cadr expr))
           ((begin) (eval-sequence (cdr expr) env))
           (else (apply-procedure (evaluate (car expr) env)
                                  (map (lambda (e) (evaluate e env)) (cdr expr))))))))
(define (eval-sequence exprs env)
  (if (null? (cdr exprs))
      (evaluate (car exprs) env)
      (begin (evaluate (car exprs) env) (eval-sequence (cdr exprs) env))))
(define (apply-procedure proc args)
  (if (procedure? proc)
      (apply proc args)
      (eval-sequence (caddr proc) (extend (cadddr proc) (cadr proc) args))))
(define global (extend '() '(+ - * < = list) (list + - * < = list)))
(define (run expr) (evaluate expr global))
(run '(define fact (lambda (n) (if (< n 2) 1 (* n (fact (- n 1)))))))
(display (run '(fact 20)))
(newline)
(run '(define map1 (lambda (f l) (if (= 0 (length l)) (quote ()) (cons (f (car l)) (map1 f (cdr l)))))))
(run '(define length (lambda (l) (if (= l (quote ())) 0 1))))
(display (run '(list (fact 5) ((lambda (x y) (+ x y)) 3 4) (quote sym))))
(newline)
(run '(define make-adder (lambda (n) (lambda (x) (+ x n)))))
(display (run '((make-adder 10) 32)))
(newline)

