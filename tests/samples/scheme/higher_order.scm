; Higher-order procedures and closures.
(define (show x) (write x) (newline))
(define (compose . fs)
  (if (null? fs) (lambda (x) x)
      (lambda (x) ((car fs) ((apply compose (cdr fs)) x)))))
(define inc (lambda (x) (+ x 1)))
(show ((compose inc inc (lambda (x) (* x 10))) 5))
(define (make-counter)
  (let ((n 0)) (lambda () (set! n (+ n 1)) n)))
(define c1 (make-counter))
(define c2 (make-counter))
(c1) (c1)
(show (list (c1) (c2)))
(show (map (lambda (x y) (* x y)) '(1 2 3) '(4 5 6)))
(show (apply max '(3 7 2)))
(show (apply + 1 2 '(3 4)))
(let ((acc '())) (for-each (lambda (x y) (set! acc (cons (+ x y) acc))) '(1 2) '(10 20)) (show acc))
(define (curry f . args) (lambda more (apply f (append args more))))
(show ((curry list 1 2) 3 4))
(define (memo-fib)
  (let ((table (make-hash-table)))
    (define (fib n)
      (or (hash-table-ref/default table n #f)
          (let ((v (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
            (hash-table-set! table n v)
            v)))
    fib))
(show ((memo-fib) 80))
(show (let loop ((i 0) (fs '())) (if (= i 3) (map (lambda (f) (f)) (reverse fs)) (loop (+ i 1) (cons (lambda () i) fs)))))
(define-values (evens odds) (partition even? (iota 10)))
(show (list evens odds))
(show (fold-left cons '() '(1 2 3)))
(show (reduce + 0 (map (lambda (x) (* x x)) (iota 10))))
(show (sort (list 5 2 8 1) >))
(show (list-sort < (list 3 2 1)))
(show (assoc 2.0 '((1 . a) (2 . b)) =))
(show (member 3 '(1 2 3 4) (lambda (a b) (= a b))))
(show (string-map (lambda (c) (if (char=? c #\a) #\o c)) "banana"))
(show (vector-map (lambda (x) (* x x)) #(1 2 3)))

