; Lists: R7RS and SRFI 1.
(define (show x) (write x) (newline))
(define l (list 3 1 4 1 5 9 2 6))
(show (length l))
(show (reverse l))
(show (append '(1 2) '(3) '() '(4 5)))
(show (list-tail l 5))
(show (list-ref l 2))
(show (memv 4 l))
(show (assq 'b '((a 1) (b 2) (c 3))))
(show (assoc "b" '(("a" . 1) ("b" . 2))))
(show (list-copy '(1 2 3)))
(show (cons* 1 2 '(3 4)))
(show (iota 5 1))
(show (take l 3))
(show (drop l 5))
(show (last l))
(show (filter odd? l))
(show (remove odd? l))
(show (fold + 0 l))
(show (fold cons '() '(1 2 3)))
(show (fold-right cons '() '(1 2 3)))
(show (reduce max 0 l))
(show (delete 1 l))
(show (delete-duplicates l))
(show (any even? '(1 3 4)))
(show (every positive? '(1 2 3)))
(show (find (lambda (x) (> x 4)) l))
(show (list-index even? l))
(show (count odd? l))
(show (append-map (lambda (x) (list x x)) '(1 2)))
(show (filter-map (lambda (x) (and (odd? x) (* x 10))) l))
(call-with-values (lambda () (partition even? l)) (lambda (a b) (show (list a b))))
(call-with-values (lambda () (span odd? '(1 3 4 5))) (lambda (a b) (show (list a b))))
(show (take-while odd? '(1 3 4 5)))
(show (drop-while odd? '(1 3 4 5)))
(show (zip '(1 2 3) '(a b c)))
(show (unfold (lambda (x) (> x 5)) (lambda (x) (* x x)) (lambda (x) (+ x 1)) 1))
(show (list-tabulate 4 (lambda (i) (* i i))))
(show (lset-union eq? '(a b) '(b c)))
(show (lset-intersection eq? '(a b c) '(b c d)))
(show (lset-difference eq? '(a b c) '(b)))
(show (map + '(1 2 3) '(10 20 30)))
(show (assq 'x '()))
(show (last-pair '(1 2 3)))

