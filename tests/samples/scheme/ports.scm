; Ports: strings, reading data, reading lines, write and display.
(define out (open-output-string))
(write 'symbol out)
(display " " out)
(write "строка\n" out)
(display " " out)
(write #\x out)
(display (get-output-string out))
(newline)
(define in (open-input-string "(1 2 (3)) word \"text\" 42 #t #(1 2)"))
(let loop ((x (read in)))
  (unless (eof-object? x)
    (write x)
    (display ";")
    (loop (read in))))
(newline)
(define lines (open-input-string "first line\nsecond line\n"))
(display (read-line lines)) (display "|")
(display (read-line lines)) (display "|")
(display (eof-object? (read-line lines)))
(newline)
(define chars (open-input-string "ab"))
(define c1 (peek-char chars))
(define c2 (read-char chars))
(define c3 (read-char chars))
(display (list c1 c2 c3 (eof-object? (read-char chars))))
(newline)
(display (read-string 3 (open-input-string "abcdef")))
(newline)
(define bytes (open-input-bytevector (bytevector 1 2 3)))
(define b1 (read-u8 bytes))
(define b2 (peek-u8 bytes))
(display (list b1 b2 (bytevector-length (read-bytevector 5 bytes))))
(newline)
(define bout (open-output-bytevector))
(write-u8 65 bout)
(write-bytevector (bytevector 66 67) bout)
(display (utf8->string (get-output-bytevector bout)))
(newline)
(write-string "write-string" (current-output-port))
(newline)
(write-char #\Ж)
(newline)
(write (list "a" #\b 'c 1.5))
(newline)
(let ((p (open-input-string "")))
  (display (list (input-port? p) (output-port? p) (textual-port? p) (input-port-open? p)))
  (close-port p)
  (display (input-port-open? p)))
(newline)
(define cyclic (list 1 2 3))
(set-cdr! (cddr cyclic) cyclic)
(write cyclic)
(newline)

